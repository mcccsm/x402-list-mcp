{
  "name": "x402-list-mcp",
  "version": "0.5.2",
  "mcpName": "com.x402-list/x402-list-mcp",
  "description": "Find and vet x402 payment APIs before your agent pays one. Seven tools over the public x402-list directory: search and rank listed services, live uptime and health windows, per-endpoint USD pricing, on-chain-verified facilitator settlement volume, tracked price/payout/schema changes, and paid on-demand assessments (x402 pass-through: never holds keys, never signs, never settles). Thin wrapper over the public x402-list API.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "bin": {
    "x402-list-mcp": "dist/index.js"
  },
  "main": "dist/index.js",
  "exports": {
    ".": "./dist/index.js"
  },
  "files": [
    "dist",
    "SKILL.md",
    "README.md",
    "CHANGELOG.md"
  ],
  "keywords": [
    "mcp",
    "model-context-protocol",
    "x402",
    "payments",
    "stablecoin",
    "usdc",
    "base",
    "facilitator",
    "ai-agents",
    "directory",
    "discovery",
    "trust",
    "uptime",
    "agent"
  ],
  "homepage": "https://x402-list.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mcccsm/x402-list-mcp.git"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node -e \"import('node:fs').then(fs=>fs.chmodSync('dist/index.js',0o755))\"",
    "start": "node dist/index.js",
    "start:http": "MCP_HTTP_PORT=${PORT:-3000} node dist/index.js --http",
    "dev": "node --experimental-strip-types src/index.ts",
    "smoke": "node smoke-test.mjs",
    "test": "tsx --test \"src/**/*.test.ts\"",
    "prepublishOnly": "npm run build && npm test"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.29.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/node": "20.14.10",
    "tsx": "4.21.0",
    "typescript": "5.6.3"
  }
}
